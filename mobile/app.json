{
  "expo": {
    "name": "MoLakaz",
    "slug": "molakaz",
    "scheme": "molakaz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ghavish.molakaz"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2F3F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ghavish.molakaz"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "MoLakaz uses the camera so you can snap a before and after photo of a chore.",
          "photosPermission": "MoLakaz lets you pick a before or after photo of a chore from your gallery."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MoLakaz uses the camera so you can snap a before and after photo of a chore.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "MoLakaz uses the microphone so you can tell the assistant what you need, or describe your home, out loud."
        }
      ],
      "expo-notifications",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
